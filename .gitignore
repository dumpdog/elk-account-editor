# obsolete database-editing tool (embeds a database password)
/port/src/Elk.AccountTool/
# real addresses and paths for this machine
/docs/LOCAL-NOTES.md

# accounts library of a build run from git (update-from-git -Run)
/ElkEditor data/

# strings that must never be published (read by rust/packaging/publish-clean.ps1)
/.publish-deny.txt
